+/* Mission tests (method v1) and the Arabic method page. Uses the app's theme tokens. */
+
+.mt {
+  max-width: 1280px;
+  margin: 0 auto;
+}
+
+.mt-head h1 {
+  margin: 0.2rem 0 0.4rem;
+}
+
+.mt-lede {
+  max-width: 78ch;
+  color: var(--text-2, #b9c6d8);
+  margin: 0 0 0.9rem;
+}
+
+.mt-banner {
+  padding: 0.7rem 0.9rem;
+  border: 1px solid rgba(242, 166, 90, 0.55);
+  border-radius: var(--radius);
+  background: rgba(242, 166, 90, 0.08);
+  font-size: 0.86rem;
+}
+
+.mt-banner p {
+  margin: 0;
+}
+
+.mt-banner__links {
+  display: flex;
+  flex-wrap: wrap;
+  align-items: center;
+  justify-content: space-between;
+  gap: 0.5rem 1rem;
+  margin-top: 0.5rem !important;
+}
+
+.mt-controls {
+  display: grid;
+  grid-template-columns: minmax(220px, 360px) minmax(0, 1fr);
+  gap: 0.8rem 1.2rem;
+  margin: 1rem 0 0.6rem;
+}
+
+.mt-field {
+  display: grid;
+  gap: 0.3rem;
+  font-size: 0.8rem;
+  color: var(--muted);
+}
+
+.mt-field select {
+  font: inherit;
+  font-size: 0.9rem;
+  padding: 0.45rem 0.55rem;
+  border: 1px solid var(--border-strong);
+  border-radius: 8px;
+  background: var(--panel-2);
+  color: var(--text, #e6edf6);
+}
+
+.mt-tests {
+  display: flex;
+  flex-wrap: wrap;
+  gap: 0.4rem;
+}
+
+.mt-test {
+  font: inherit;
+  font-size: 0.85rem;
+  padding: 0.4rem 0.75rem;
+  border: 1px solid var(--border-strong);
+  border-radius: 999px;
+  background: transparent;
+  color: var(--text, #e6edf6);
